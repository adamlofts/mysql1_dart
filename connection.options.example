# create connection.options to define how the integration tests connect
user=test
password=test
#defaults to 3306
port=3306
db=test
#defaults to localhost
host=localhost
#to connect over TLS, the certificate to trust: the server's own or the
#authority which signed it. The server has to be reached by a name or address
#the certificate is for.
#ssl_ca=test/unit/tls/test_server_cert_intentionally_public.pem
#the port of a second server on the same host which has TLS turned off, for
#the test that asking for TLS does not connect without it
#no_tls_port=3307
